# Kompendium-API v2 – Konfiguration (Kopie als .env; siehe app/settings.py und PLAN.md 3.5)

LOG_LEVEL=INFO

# ZIM-Archive: Verzeichnis (Volume mit active.json, vom Sync-Job gepflegt) oder explizite Pfade (Entwicklung)
ZIM_DIR=/data/zim
ZIM_PROFILE=standard
# Pflichtarchive fuer /ready; leer = aus config/zim_subscriptions.yaml fuer ZIM_PROFILE abgeleitet
ZIM_REQUIRED=
# ZIM_PATHS=C:/pfad/wikipedia_de_all_nopic_2026-01.zim,C:/pfad/klexikon_de_all_maxi_2026-08.zim

# Sync-Job (compendium zim sync --loop im Updater-Sidecar): Katalog monatlich pruefen (D16)
ZIM_BOOTSTRAP_DOWNLOAD=false
ZIM_SYNC_INTERVAL=30d
ZIM_RETENTION_HOURS=24
# ZIM_CATALOG_URL=https://opds.library.kiwix.org/catalog/v2/entries
# ZIM_DOWNLOAD_HOSTS=download.kiwix.org,lb.download.kiwix.org,mirror.download.kiwix.org

STATE_DIR=/data/state
CONFIG_DIR=config
TEMPLATE_DEFAULT=sc26
MATCHER_DEFAULT=hybrid_light
FACETS_LEVEL=minimal
FACETS_VISIBLE=false
# Statisches Embedding-Modell fuer hybrid_light (D20): im Image unter /models/m2v gebacken;
# lokal Hugging-Face-ID mit HF_HUB_OFFLINE=1, wenn das Modell im Cache liegt. Leer = ohne Embeddings.
MODEL2VEC_PATH=/models/m2v
# Ab dieser fusionierten Trefferstaerke gilt ein Ranker-Treffer als Beleg; darunter greift der
# Standardbaustein des Templates (Fachinhalte in sc26). Mit Glaettung 0,5 gemessen auf eval/gold (D28):
# 0,45 -> 0,65 hebt macro-F1 von 0,430 auf 0,447 und senkt falsch gedruckte Absaetze um ein Drittel
POLICY_CONFIDENT_SCORE=0.65
# Anteil des Abschnittsmittels an jedem Score (Absätze unter einer Überschrift stützen sich); 0 = aus
POLICY_SECTION_SMOOTHING=0.5
# Korpus je Kompendium: Artikel und Absaetze. Die Absatzgrenze fuellt in der Reihenfolge Hauptartikel,
# Klexikon, angeforderte Materialien, verlinkte, gesuchte Artikel; der Rest steht als chunks_truncated im Audit
CORPUS_MAX_ARTICLES=12
CORPUS_MAX_CHUNKS=400
# Goldstandard fuer compendium eval und POST /api/v2/matching/compare (Admin); im Image nicht enthalten
EVAL_GOLD_DIR=eval/gold

# Lehrplanbezuege (Teil 2): Vollabzug aus MEM in STATE_DIR/lehrplan.db durch den Harvest-Sidecar
# (compendium lehrplan harvest --loop); die API liest nur den Cache (D16). Woechentlich Zaehlung pruefen,
# Vollabzug bei Aenderung oder spaetestens nach LEHRPLAN_HARVEST_MAX_AGE (Dauer rund 25 Minuten, 2.605 Anfragen).
LEHRPLAN_ENDPOINT=https://sparql.mem.edufeed.org/sparql/
LEHRPLAN_CHECK_INTERVAL=7d
LEHRPLAN_HARVEST_MAX_AGE=30d
LEHRPLAN_REQUEST_PAUSE_S=0.5
# Teil 2 enthaelt alle Treffer (D23: Kompendialtexte duerfen lang sein; Optik ca. 28.000 Zeichen).
# Optionale Kappung: Lernbereiche je Bundesland und Bildungsstufe, 0 = keine
LEHRPLAN_MAX_GROUPS_PER_LAND=0

# Sammlungen (Teil 3) und Wissens-Sammlung: edu-sharing-Repository, anonym oder mit Basic-Auth; leer = aus.
# Cache in STATE_DIR/wlo_cache.db (Sammlungen 1 h, Materialtexte 7 Tage). Nur CC0, PDM, CC BY, CC BY-SA werden
# woertlich uebernommen (PLAN.md 6.3). Teil 3 listet alle Inhalte (D23); COLLECTION_MAX_ITEMS kappt optional (0 = alle).
EDU_SHARING_BASE_URL=https://redaktion.openeduhub.net/edu-sharing/rest
EDU_SHARING_USER=
EDU_SHARING_PASSWORD=
EDU_SHARING_TIMEOUT_S=30
COLLECTION_CACHE_TTL_S=3600
COLLECTION_MAX_ITEMS=0
MATERIAL_TEXT_CACHE_TTL_S=604800
KNOWLEDGE_MAX_MATERIALS=30
KNOWLEDGE_MAX_CHARS=20000
KNOWLEDGE_CONCURRENCY=4

# LLM über die b-api (optional; Standard aus). Provider und Modell sind umschaltbar (D19, D25).
# Modi je Anfrage: rule-based (Standard), hybrid-fast (LLM_FAST_SECTIONS plus Router), hybrid-quality
# (alle Inhaltsbausteine mit Belegen). Ohne LLM_ENABLED=true oder ohne B_API_KEY fallen Hybrid-Anfragen auf
# den Regelmodus zurück; das Frontmatter nennt dann mode und mode_requested.
LLM_ENABLED=false
LLM_MODE_DEFAULT=rule-based
LLM_FAST_SECTIONS=sc26_1,sc26_11
B_API_KEY=
B_API_BASE_URL=https://b-api.staging.openeduhub.net
B_API_PROVIDER=openai
B_API_MODEL=gpt-5.6-luna
# GPT-5- und o-Serie: reasoning_effort und verbosity (Standard low/low); klassische Modelle: LLM_TEMPERATURE
LLM_REASONING_EFFORT=low
LLM_VERBOSITY=low
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=120
LLM_MAX_CONCURRENCY=4
LLM_ATTEMPTS=3
# Kostenschutz: Tokens je Kompendium und je Tag. Der Tageszähler liegt in STATE_DIR/llm_budget.db, gilt für alle
# Worker gemeinsam und übersteht Neustarts.
LLM_MAX_TOKENS_PER_REQUEST=20000
LLM_DAILY_TOKEN_BUDGET=2000000
# Sätze ohne gültigen, deckenden Beleg: drop (verwerfen, Standard) oder mark (als Schlussfolgerung kennzeichnen)
LLM_UNSUPPORTED_SENTENCES=drop
# LLM-Router für Zweifelsfälle des Matchings (nur in den Hybridmodi)
LLM_ROUTER_ENABLED=true
LLM_ROUTER_MAX_CHUNKS=12

# Frist je Anfrage fuer die LLM-Arbeit und das Lesen der Materialtexte: Aufrufe bekommen hoechstens die Restzeit,
# danach entsteht der Rest extraktiv, nicht geholte Materialtexte bleiben draussen (audit.knowledge.timed_out)
REQUEST_TIMEOUT_S=120
# Anfragen je Minute und Client auf compendium, collections/overview und lehrplan/search (je Worker); 0 = aus.
# Hinter einem Reverse-Proxy braucht uvicorn FORWARDED_ALLOW_IPS, sonst teilen sich alle Clients ein Fenster.
RATE_LIMIT=60
# /docs, /redoc und /openapi.json ausliefern
API_DOCS_ENABLED=true
# Prometheus: GET /metrics; METRICS_TOKEN verlangt Authorization: Bearer <Token>, leer = ohne Token.
# Im Image legen die Worker ihre Werte in PROMETHEUS_MULTIPROC_DIR ab (Standard /tmp/prometheus, beim Start
# geleert); /metrics summiert sie. Die Variable setzt der API-Befehl des Images selbst; nicht hier eintragen,
# denn diese Datei gilt auch für die Sidecars.
METRICS_ENABLED=true
METRICS_TOKEN=
# Worker-Prozesse der API im Image (liest uvicorn selbst)
# WEB_CONCURRENCY=2
# Admin-Endpunkte (ZIM-Katalog, Sync-Anstoss, Loeschen, Harvest-Anstoss, Matching-Vergleich) nur mit Token;
# leer = deaktiviert
ADMIN_TOKEN=
